rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 헬퍼 함수: 인증된 사용자 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 헬퍼 함수: 사용자 소유 확인
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ======================================
    // 사용자 문서 (householdId 저장용)
    // ======================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // 기존 사용자별 서브컬렉션 (레거시 지원)
      match /fridge_items/{itemId} {
        allow read, write: if isOwner(userId);
      }

      match /stock_items/{itemId} {
        allow read, write: if isOwner(userId);
      }

      match /alerts/{alertId} {
        allow read, write: if isOwner(userId);
      }

      match /receipts/{receiptId} {
        allow read, write: if isOwner(userId);
      }

      match /backups/{backupId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ======================================
    // 가구(Household) 관련 규칙
    // ======================================
    match /households/{householdId} {
      // 가구 멤버인지 확인
      function isMember() {
        return isAuthenticated() &&
          request.auth.uid in resource.data.members;
      }

      // 가구의 역할 가져오기
      function getMemberRole() {
        return resource.data.members[request.auth.uid].role;
      }

      // 소유자인지 확인
      function isHouseholdOwner() {
        return isMember() && getMemberRole() == 'owner';
      }

      // 편집 가능한지 확인 (owner 또는 editor)
      function canEdit() {
        return isMember() && (getMemberRole() == 'owner' || getMemberRole() == 'editor');
      }

      // 가구 문서 규칙
      allow read: if isMember();
      allow create: if isAuthenticated();
      allow update: if isHouseholdOwner() ||
        // 멤버 가입 시 자신을 추가하는 것은 허용
        (isAuthenticated() &&
         request.resource.data.members[request.auth.uid] != null &&
         resource.data.members[request.auth.uid] == null);
      allow delete: if isHouseholdOwner();

      // 초대 코드 서브컬렉션
      match /inviteCodes/{codeId} {
        // 모든 인증된 사용자가 초대 코드 조회 가능 (가입 시 검증용)
        allow read: if isAuthenticated();
        // 소유자만 생성/수정/삭제 가능
        allow create, update, delete: if isHouseholdOwner();
      }

      // 냉장고 아이템 서브컬렉션
      match /fridge_items/{itemId} {
        allow read: if isMember();
        allow create, update, delete: if canEdit();
      }

      // 재고 아이템 서브컬렉션
      match /stock_items/{itemId} {
        allow read: if isMember();
        allow create, update, delete: if canEdit();
      }

      // 알림 서브컬렉션
      match /alerts/{alertId} {
        allow read: if isMember();
        allow create, update, delete: if canEdit();
      }

      // 영수증 서브컬렉션
      match /receipts/{receiptId} {
        allow read: if isMember();
        allow create, update, delete: if canEdit();
      }

      // 백업 서브컬렉션
      match /backups/{backupId} {
        allow read: if isMember();
        allow create, update, delete: if isHouseholdOwner();
      }
    }
  }
}
